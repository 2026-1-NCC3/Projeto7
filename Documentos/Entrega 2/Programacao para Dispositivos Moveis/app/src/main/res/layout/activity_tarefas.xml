<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <Button
            android:id="@+id/btnVoltar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Voltar"
            android:backgroundTint="#CCCCCC"
            android:textColor="#000000"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tarefas de Casa"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/tela_principal"
            android:layout_marginTop="10dp"/>

        <TextView
            android:id="@+id/txtTotalExercicios"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Carregando exercícios..."
            android:layout_marginTop="8dp"/>

        <LinearLayout
            android:id="@+id/lista_exercicios"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Registrar Execução"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/tela_principal"
            android:layout_marginTop="24dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nível de dor (0 = sem dor, 10 = dor máxima):"
            android:layout_marginTop="8dp"/>

        <SeekBar
            android:id="@+id/seekBarDor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="10"
            android:progress="0"
            android:layout_marginTop="8dp"/>

        <TextView
            android:id="@+id/txtNivelDor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nível selecionado: 0"
            android:layout_marginTop="4dp"/>

        <Button
            android:id="@+id/btnCheckin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✓ Confirmar Execução"
            android:backgroundTint="@color/tela_principal"
            android:textColor="#FFFFFF"
            android:layout_marginTop="12dp"/>

        <!-- Histórico -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Histórico de Execuções"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/tela_principal"
            android:layout_marginTop="24dp"/>

        <LinearLayout
            android:id="@+id/listaHistorico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp"/>

    </LinearLayout>

</ScrollView>