<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo_cinza">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:background="@color/tela_principal">


            <ImageView
                android:id="@+id/img_maya"
                android:layout_width="160dp"
                android:layout_height="match_parent"
                android:layout_alignParentEnd="true"
                android:scaleType="centerCrop"
                android:src="@drawable/bg_login" />

            <ImageView
                android:layout_width="169dp"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_marginStart="16dp"
                android:layout_marginTop="28dp"
                android:contentDescription="Logo"
                android:src="@drawable/logo_semfundobranca" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_alignParentBottom="true"
                android:layout_marginBottom="20dp"
                android:layout_marginStart="16dp">

                <TextView
                    android:id="@+id/txt_saudacao"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Olá, Paciente!"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/branco" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Como está se sentindo hoje?"
                    android:textSize="14sp"
                    android:textColor="@color/branco" />
            </LinearLayout>
        </RelativeLayout>

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:padding="16dp"
            android:layout_marginTop="8dp">

            <!-- AGENDAMENTOS -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_agendamentos"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/calendar"
                        android:layout_marginStart="12dp"
                        app:tint="@color/tela_principal" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" Agendamentos"
                        android:textSize="15sp"
                        android:textColor="@color/cinza_escuro" />
                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- SEU PROGRESSO -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_progresso"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/progress"
                        android:layout_marginStart="12dp"
                        app:tint="@color/tela_principal" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="  Progresso"
                        android:textSize="15sp"
                        android:textColor="@color/cinza_escuro" />
                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- MEUS EXERCÍCIOS -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_exercicios"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/exercise"
                        android:layout_marginStart="12dp"
                        app:tint="@color/tela_principal" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="  Exercícios"
                        android:textSize="15sp"
                        android:textColor="@color/cinza_escuro" />
                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- MENSAGENS -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_mensagens"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/message"
                        android:layout_marginStart="12dp"
                        app:tint="@color/tela_principal" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="  Mensagens"
                        android:textSize="15sp"
                        android:textColor="@color/cinza_escuro" />
                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </GridLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Próximo agendamento"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/cinza_escuro"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/branco">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/img_foto_dra"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/foto_dra_circular"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"/>

   <LinearLayout
       android:layout_width="wrap_content"
       android:layout_height="wrap_content"
       android:orientation="vertical"
       android:layout_toEndOf="@id/img_foto_dra"
       android:layout_marginStart="12dp"
       android:layout_centerVertical="true">

       <TextView
           android:layout_width="wrap_content"
           android:layout_height="wrap_content"
           android:text="Terça-Feira, 21 de Abril"
           android:textSize="13sp"
           android:textStyle="bold"
           android:textColor="@color/cinza_escuro" />

       <TextView
           android:layout_width="wrap_content"
           android:layout_height="wrap_content"
           android:text="Maya Yamamoto"
           android:textSize="12sp"
           android:textColor="@color/cinza_medio" />

       <TextView
           android:layout_width="wrap_content"
           android:layout_height="wrap_content"
           android:text="⏰ 10:00h – 12:00h"
           android:textSize="12sp"
           android:textColor="@color/cinza_medio" />
   </LinearLayout>

   <Button
       android:id="@+id/btn_ver_detalhes"
       android:layout_width="wrap_content"
       android:layout_height="36dp"
       android:text="Ver Detalhes"
       android:textSize="12sp"
       android:textColor="@color/branco"
       android:backgroundTint="@color/tela_principal"
       android:layout_alignParentEnd="true"
       android:layout_centerVertical="true" />

</RelativeLayout>
</androidx.cardview.widget.CardView>

<!-- Dúvidas Frequentes -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dúvidas Frequentes"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/cinza_escuro"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/branco">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/img_faq"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/duv_frequentes"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:scaleType="centerCrop" />


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tem alguma dúvida sobre o tratamento?"
                    android:textSize="13sp"
                    android:textColor="@color/cinza_escuro"
                    android:layout_toEndOf="@id/img_faq"
                    android:layout_marginStart="12dp"
                    android:layout_marginBottom="8dp"
                    android:layout_alignParentTop="true"
                    android:layout_marginTop="4dp" />

                <Button
                    android:id="@+id/btn_duvidas"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_alignParentBottom="true"
                    android:layout_marginStart="135dp"
                    android:layout_marginBottom="17dp"
                    android:layout_toEndOf="@id/img_faq"
                    android:backgroundTint="@color/tela_principal"
                    android:text="Dúvidas Frequentes"
                    android:textColor="@color/branco"
                    android:textSize="11sp" />

            </RelativeLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>

    <!-- Adicionar imagem de fundo, adiciomar as ondas, ajustar tamanho dos icones e colocar escrita,
         Arredonda imagem da maya, add botao ao lado. Add imagem nas Duvidas, e add botao tbm. -->